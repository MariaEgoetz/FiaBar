{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python -m pytest:*)",
      "Bash(.venv/Scripts/python -m ruff check:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(rm -rf:*)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(Get-Content .env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python -m ruff check . 1>&2 || exit 2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python -m pytest -q 1>&2 || exit 2"
          },
          {
            "type": "command",
            "command": ".venv/Scripts/python -m ruff check . 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
